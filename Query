CREATE TABLE GROUNDS_BOOKING_TBL (
    RECORD_ID VARCHAR2(10) PRIMARY KEY,
    TEAM_NAME VARCHAR2(50) NOT NULL,
    GROUND_NAME VARCHAR2(50) NOT NULL,
    BOOKING_DATE DATE NOT NULL,
    TIME_SLOT VARCHAR2(20) NOT NULL,
    REMARKS VARCHAR2(100)
);
CREATE SEQUENCE RECORDS_ID_SEQ
START WITH 1001
INCREMENT BY 1
NOCACHE
NOCYCLE;
SELECT RECORDS_ID_SEQ.NEXTVAL FROM dual;
SELECT * FROM GROUNDS_BOOKING_TBL;

